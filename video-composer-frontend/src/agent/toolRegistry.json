          "minimum": 0.25,
          "maximum": 1800
        }
      },
      "required": [
        "clip_id",
        "duration"
      ],
      "additionalProperties": false
    },
    "executor": "edit",
    "availability": "browser",
    "modes": [
      "edit",
      "plan"
    ]
  },
