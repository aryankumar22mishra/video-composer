  {
    "name": "plan_scenes",
    "description": "Propose a scene plan for a creation goal and obtain user approval before assembling or generating. Use the accumulated brief. Ask only for missing subject, audience or key message; default duration to 30 seconds and format to the current canvas. Use uploaded assets when suitable.",
    "arguments": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "scenes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "duration": {
                "type": "number",
                "minimum": 0.25,
                "maximum": 120
              },
              "asset_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "description",
              "duration"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "scenes"
      ],
      "additionalProperties": false
    },
    "executor": "scenes",
    "availability": "browser",
    "modes": [
      "plan"
    ]
  },
