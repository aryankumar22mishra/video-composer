# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# AI provider: google or openai
AI_PROVIDER=openai
AI_MODEL=openai/gpt-oss-20b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_EXTRA_TOOLS=open_recording_setup,stop_recording,open_media_upload
GROQ_API_KEY=
# AI_API_KEY=your-key

# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Upload limits in bytes (200 MB)
DATA_UPLOAD_MAX_MEMORY_SIZE=209715200
FILE_UPLOAD_MAX_MEMORY_SIZE=209715200

# Optional media service gateways (separate from the text planner).
# HTTPS endpoints must implement the JSON contract in AGENT_PLANNER.md.
# Leave blank to advertise an unavailable capability with an upload alternative.
TRANSCRIPTION_SERVICE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_COST_NOTICE=
TTS_SERVICE_URL=
TTS_API_KEY=
TTS_COST_NOTICE=
IMAGE_GENERATION_SERVICE_URL=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_COST_NOTICE=
VIDEO_GENERATION_SERVICE_URL=
VIDEO_GENERATION_API_KEY=
VIDEO_GENERATION_COST_NOTICE=
